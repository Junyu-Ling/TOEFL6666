GROQ_API_KEY=your_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_BASE=https://api.groq.com/openai/v1

# 可选：未配置 GROQ_API_KEY 时，后端回落 DeepSeek / Gemini / OpenAI（不要加 VITE_ 前缀）
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Upstash Redis：配对码跨设备同步（Vercel 生产环境必填）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 线上全站克隆朗读（Vercel 必填这一组，MiniMax 控制台申请，按量计费）
# MINIMAX_API_KEY=
# MINIMAX_GROUP_ID=
# MINIMAX_API_BASE=https://api.minimax.cn
# MINIMAX_TTS_MODEL=speech-2.6-turbo

# 仅本机：VoiceStudio 桌面端。线上网站访问不到 127.0.0.1
# VOICESTUDIO_API_URL=http://127.0.0.1:3900
# VOICESTUDIO_API_KEY=local
# VOICESTUDIO_TTS_MODEL=tts-1

# 可选：GPT-SoVITS（https://github.com/RVC-Boss/GPT-SoVITS）
# 不能跑在 Vercel 上。请在 GPU 机器启动官方 api_v2.py，再运行：
#   GPT_SOVITS_ORIGIN=http://127.0.0.1:9880 npm run gptsovits:bridge
# 把桥接地址填到下面（本地或 ngrok 公网 URL）
# GPT_SOVITS_API_URL=http://127.0.0.1:9888

# 说明：
# 1. 本地开发：把本文件复制为 .env，npm run dev 会通过 Vite 代理调用 /api
# 2. Vercel：在 Project → Settings → Environment Variables 中配置同样的键，不要提交 Git
# 3. 不要把 API Key 写成 VITE_*，否则会打进前端包

# GitHub 登录（不需要 Supabase）
GITHUB_CLIENT_ID=Ov23li2dm43mGcix56sF
GITHUB_CLIENT_SECRET=

# Google / Gmail 登录（OAuth；管理员邮箱 jy.ling.cc@gmail.com 会自动成为管理员）
# 在 Google Cloud Console 创建 OAuth 客户端（类型：Web 应用），Authorized redirect URIs 填：
#   http://localhost:5175/api/auth/google/callback
#   https://toefl-6666.vercel.app/api/auth/google/callback
# 再把下面两项写进本地 .env 和 Vercel Environment Variables，然后重新部署。
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_SECRET=  # 可选；不填则用 GITHUB_CLIENT_SECRET / GOOGLE_CLIENT_SECRET 签名会话
# READING_FILL_SECRET=  # 可选；不填则用上面的密钥解密阅读填词和词汇配对

# 阅读填词管理员（代码已写死 jy.ling.cc@gmail.com；下面可再追加）
ACCESS_ADMIN_EMAILS=jy.ling.cc@gmail.com
# ACCESS_ADMIN_USER_IDS=gh_你的GitHub数字ID
# ACCESS_ADMIN_PHONES=
