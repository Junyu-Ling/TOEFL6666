DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# 可选：未配置 DEEPSEEK_API_KEY 时，后端回落（只放在 .env / Worker Secrets，不要加 VITE_ 前缀）
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Upstash Redis：配对码跨设备同步（Cloudflare / Vercel 生产环境必填）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 说明：
# 1. 本地开发：把本文件复制为 .env，npm run dev 会通过 Vite 代理调用 /api
# 2. Cloudflare Workers：密钥用 wrangler secret put 或 Dashboard Secrets，不要提交 Git
# 3. 复制本文件为 .dev.vars 可配合 npm run cf:dev（wrangler dev）
# 4. 不要把 API Key 写成 VITE_*，否则会打进前端包
