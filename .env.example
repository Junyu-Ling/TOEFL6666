DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Upstash Redis：按 Google 账号存储学习进度（Vercel 生产环境必填）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase：仅用于 Google 登录（不必使用 Supabase 数据库）
# 客户端（Vite 构建时注入，前缀 VITE_）
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# 服务端验证 JWT（切勿暴露到前端）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Supabase 配置步骤：
# 1. 创建 Supabase 项目
# 2. Authentication → Providers → 启用 Google（填入 Google OAuth Client ID/Secret）
# 3. Authentication → URL Configuration → Redirect URLs 添加：
#    - http://localhost:5173
#    - https://toefl-6666.vercel.app
# 4. 将 URL 与 Key 填入上方变量，并在 Vercel 环境变量中同步配置
