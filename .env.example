DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# 可选：未配置 DEEPSEEK_API_KEY 时，后端回落（只放在 .env / Vercel 环境变量，不要加 VITE_ 前缀）
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Upstash Redis：配对码跨设备同步（Vercel 生产环境必填）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 可选：本人声音克隆后仅用于站内读单词（MiniMax）
# MINIMAX_API_KEY=
# MINIMAX_GROUP_ID=
# MINIMAX_API_BASE=https://api.minimax.cn
# MINIMAX_TTS_MODEL=speech-2.6-turbo

# 说明：
# 1. 本地开发：把本文件复制为 .env，npm run dev 会通过 Vite 代理调用 /api
# 2. Vercel：在 Project → Settings → Environment Variables 中配置同样的键，不要提交 Git
# 3. 不要把 API Key 写成 VITE_*，否则会打进前端包

# GitHub 登录（不需要 Supabase）
GITHUB_CLIENT_ID=Ov23li2dm43mGcix56sF
GITHUB_CLIENT_SECRET=
# AUTH_SECRET=  # 可选；不填则用 GITHUB_CLIENT_SECRET 签名会话
# READING_FILL_SECRET=  # 可选；不填则用上面的密钥解密阅读填词

# 阅读填词管理员（逗号分隔，命中任一即可）
# ACCESS_ADMIN_EMAILS=you@example.com
# ACCESS_ADMIN_USER_IDS=gh_你的GitHub数字ID
# ACCESS_ADMIN_PHONES=
