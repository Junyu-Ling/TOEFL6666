{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "server/data/readingFillBlank.json.enc"
    }
  },
  "headers": [
    {
      "source": "/wordlists/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/wordlists-sat/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/api/wordlists/:path*",
      "destination": "/wordlists/:path*",
      "permanent": true
    },
    {
      "source": "/api/wordlists-sat/:path*",
      "destination": "/wordlists-sat/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?__route=:path*"
    },
    {
      "source": "/((?!api/|wordlists/|wordlists-sat/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
